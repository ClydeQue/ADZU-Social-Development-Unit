# Local Environment Variables (Optional)
# Copy this to .env.local for local overrides
# .env.local is git-ignored and won't be committed

# API Configuration - Uncomment to override
# VITE_API_URL=http://localhost:5001
# VITE_API_URL=https://adzu-sdu-backend.vercel.app

# Example Environment Configuration
# Copy this to .env.local for local overrides (git-ignored)

# Supabase Configuration
# ===========================
VITE_SUPABASE_URL=https://hanrnoqvzkqwvotcexva.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend API Configuration
# ===========================
# Option 1: Auto-fallback (recommended)
# Leave commented to automatically detect localhost or use production
# VITE_API_URL=

# Option 2: Force localhost
# VITE_API_URL=http://localhost:5001

# Option 3: Force production
# VITE_API_URL=https://adzu-sdu-backend.vercel.app

# App Configuration
# ===========================
VITE_APP_NAME=AdZU Social Development Unit
VITE_APP_VERSION=1.0.0

# Development Settings
# ===========================
# VITE_DEBUG=true
# VITE_ENABLE_DEBUG_PANEL=true
# VITE_ENABLE_MOCK_DATA=false

# Debug Mode
# VITE_DEBUG=true

# Feature Flags (if needed)
# VITE_ENABLE_NOTIFICATIONS=true
# VITE_ENABLE_REPORTS=true
